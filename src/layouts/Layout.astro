---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  schema?: string;
}

const defaultDescription =
  "Agenție de evenimente pentru copii în București și Ilfov. Animatori dedicați, programe adaptate vârstei, face painting și modelaj baloane.";

const {
  title,
  description = defaultDescription,
  canonical,
  noindex = false,
  schema,
} = Astro.props;

const canonicalUrl =
  canonical ?? new URL(Astro.url.pathname, "https://animaparty.ro").href;

const entitySchema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://animaparty.ro/#organization",
      "name": "AnimaParty",
      "url": "https://animaparty.ro/",
      "logo": "https://animaparty.ro/animaparty-logo-mark.svg",
      "telephone": "+40792864811",
      "email": "contact@animaparty.ro",
      "areaServed": ["București", "Ilfov"]
    },
    {
      "@type": "WebSite",
      "@id": "https://animaparty.ro/#website",
      "url": "https://animaparty.ro/",
      "name": "AnimaParty",
      "publisher": { "@id": "https://animaparty.ro/#organization" },
      "inLanguage": "ro-RO"
    }
  ]
});
---

<!doctype html>
<html lang="ro">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<meta name="description" content={description} />
		<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
		{!noindex && <link rel="canonical" href={canonicalUrl} />}
		
		<!-- Open Graph / Social Media -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://animaparty.ro/hero-bucuresti.webp" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://animaparty.ro/hero-bucuresti.webp" />
		
		<!-- Schema.org JSON-LD -->
		<script type="application/ld+json" set:html={entitySchema} />
		{schema && <script type="application/ld+json" set:html={schema} />}

		<!-- Premium Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
	</head>
	<body>
		<Header />
		<slot />
	<Footer />
	</body>
</html>
<style is:global>
	@import '../styles/global.css';
</style>
