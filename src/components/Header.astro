---
import BrandLogo from './BrandLogo.astro';
const nav = [
  ['București','/animatori-petreceri-copii-bucuresti/'],
  ['Ilfov','/animatori-petreceri-copii-ilfov/'],
  ['Ghid','/animatori-petreceri-copii/'],
  ['Servicii','/servicii/'],
  ['Pachete','/#pachete'],
  ['Contact','/contact/'],
];
---
<header class="site-header">
  <div class="site-header__inner container">
    <BrandLogo />
    <nav class="desktop-nav" aria-label="Navigație principală">
      {nav.map(([label,href]) => <a href={href}>{label}</a>)}
    </nav>
    <a class="header-phone" href="tel:+40792864811" aria-label="Sună AnimaParty la 0792 864 811">0792 864 811</a>
    <details class="mobile-menu">
      <summary aria-label="Deschide meniul"><span></span><span></span><span></span></summary>
      <div class="mobile-menu__panel">
        {nav.map(([label,href]) => <a href={href}>{label}</a>)}
        <a class="mobile-phone" href="tel:+40792864811">Sună: 0792 864 811</a>
      </div>
    </details>
  </div>
</header>
