---
import { faqHome } from '../data/faqHome';
---
<section class="py-16 bg-secondary" id="faq" style="padding: 80px 0; background: var(--bg-secondary);">
  <div class="container mx-auto" style="max-width: 800px;">
    <h2 class="text-3xl font-bold text-center mb-10 text-primary" style="font-family: 'Playfair Display', serif; font-size: 2.25rem; margin-bottom: 40px;">Întrebări Frecvente</h2>
    <div class="space-y-6" style="display: flex; flex-direction: column; gap: 24px;">
      {faqHome.map((faq) => (
        <div class="faq-item" style="border-bottom: 1px solid var(--border-subtle); padding-bottom: 24px;">
          <h3 class="text-lg font-bold mb-2 text-primary" style="font-size: 1.15rem; margin-bottom: 8px;">{faq.question}</h3>
          <p class="text-secondary" style="line-height: 1.6;">{faq.answer}</p>
        </div>
      ))}
    </div>
  </div>
</section>
