---
<div class="sticky-bottom-cta" id="sticky-cta">
  <div class="container sticky-container">
    <div class="sticky-text">
      <span class="sticky-title">Verifică disponibilitatea pentru weekend</span>
      <span class="sticky-subtitle">Verifică acum pentru data ta</span>
    </div>
    <div class="sticky-actions">
      <a href="https://wa.me/40792864811" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-sm">
        <svg class="icon-svg" style="width:16px;height:16px;margin-right:6px;" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
        WhatsApp
      </a>
      <a href="tel:+40792864811" class="btn btn-primary btn-sm btn-call-mobile">
        <svg class="icon-svg" style="width:16px;height:16px;margin-right:6px;" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        Sună
      </a>
    </div>
  </div>
</div>

<script>
  // Hide CTA when scrolling into Contact section or Hero
  document.addEventListener('DOMContentLoaded', () => {
    const stickyCta = document.getElementById('sticky-cta');
    const contactSection = document.querySelector('.contact-section') as HTMLElement;
    const heroSection = document.querySelector('.hero-section') as HTMLElement;
    
    if (!stickyCta) return;
    
    const handleScroll = () => {
      const scrollY = window.scrollY;
      const windowHeight = window.innerHeight;
      
      // Don't show in hero
      if (heroSection && scrollY < heroSection.offsetHeight * 0.5) {
        stickyCta.classList.remove('visible');
        return;
      }
      
      // Don't show in contact
      if (contactSection) {
        const contactTop = contactSection.getBoundingClientRect().top;
        if (contactTop < windowHeight * 0.8) {
          stickyCta.classList.remove('visible');
          return;
        }
      }
      
      stickyCta.classList.add('visible');
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    // Initial check
    setTimeout(handleScroll, 100);
  });
</script>

<style>
  .sticky-bottom-cta {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: var(--bg-tertiary);
    border-top: 1px solid var(--border-subtle);
    padding: 12px 0;
    z-index: 1000;
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 -10px 40px rgba(0,0,0,0.05);
  }

  .sticky-bottom-cta.visible {
    transform: translateY(0);
  }

  .sticky-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .sticky-text {
    display: flex;
    flex-direction: column;
  }

  .sticky-title {
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .sticky-subtitle {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .sticky-actions {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  
  .btn-sm {
    padding: 10px 20px;
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .sticky-bottom-cta {
      padding: 12px 16px;
      padding-bottom: max(12px, env(safe-area-inset-bottom));
    }
    .sticky-container {
      flex-direction: column;
      gap: 12px;
    }
    .sticky-text {
      display: none; /* Hide text on mobile to save space */
    }
    .sticky-actions {
      width: 100%;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .sticky-actions .btn {
      width: 100%;
      display: flex;
      justify-content: center;
      padding: 14px 0;
      font-size: 1rem;
      font-weight: 600;
    }
  }
</style>
