---
const steps = [
  {
    title: "1. Rezervarea",
    desc: "Ne contactați pentru a verifica disponibilitatea. Stabilim împreună pachetul, personajul și detaliile locației.",
  },
  {
    title: "2. Sosirea",
    desc: "Animatorul ajunge cu 15 minute înainte de ora stabilită, pentru a se pregăti în liniște și a intra în rol.",
  },
  {
    title: "3. Distracția",
    desc: "Un program adaptat vârstei: jocuri interactive, muzică, pictură pe față și baloane modelabile pentru invitați.",
  },
  {
    title: "4. Momentul Tortului",
    desc: "Animatorul organizează cântatul 'La mulți ani', se asigură că sărbătoritul este centrul atenției și asistă la fotografii.",
  }
];
---
<section class="process-section" id="proces">
  <div class="container">
    <div class="process-header">
      <h2 class="section-title">Cum decurge programul?</h2>
      <p class="section-subtitle">O experiență fluidă și transparentă, de la prima interacțiune până la momentul tortului.</p>
    </div>
    
    <div class="editorial-timeline">
      {steps.map((step) => (
        <div class="timeline-step">
          <div class="step-line"></div>
          <div class="step-content">
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .process-section {
    background-color: var(--bg-secondary);
    padding: 120px 0;
  }

  .process-header {
    text-align: center;
    margin-bottom: 80px;
  }

  .editorial-timeline {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
  }

  .timeline-step {
    position: relative;
    padding-top: 24px;
  }

  .step-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--border-subtle);
  }
  
  .timeline-step:not(:last-child) .step-line::after {
    content: '';
    position: absolute;
    top: -3px;
    right: 0;
    width: 7px;
    height: 7px;
    background-color: var(--accent-gold);
    border-radius: 50%;
  }

  .step-content {
    padding-top: 24px;
  }

  .step-title {
    font-size: 1.5rem;
    margin-bottom: 16px;
    font-family: 'Playfair Display', serif;
    color: var(--text-primary);
  }

  .step-desc {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  @media (max-width: 992px) {
    .editorial-timeline {
      grid-template-columns: repeat(2, 1fr);
      gap: 60px 40px;
    }
    
    .timeline-step:nth-child(2) .step-line::after {
      display: none;
    }
  }

  @media (max-width: 576px) {
    .editorial-timeline {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    
    .step-line {
      display: none; /* Hide top line on mobile, use left border instead */
    }
    
    .timeline-step {
      padding-top: 0;
      padding-left: 24px;
      border-left: 1px dashed var(--accent-gold);
    }
    
    .step-content {
      padding-top: 0;
    }
    
    .timeline-step::before {
      content: '';
      position: absolute;
      top: 8px;
      left: -4px;
      width: 7px;
      height: 7px;
      background-color: var(--accent-gold);
      border-radius: 50%;
    }
  }
</style>
