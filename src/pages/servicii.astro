---
import Layout from '../layouts/Layout.astro';
import BatchHero from '../components/BatchHero.astro';
import PhotoProof from '../components/PhotoProof.astro';
import SeoFooter from '../components/SeoFooter.astro';
import { businessServices } from '../data/services';
const url='https://animaparty.ro/servicii/';
const active=Object.values(businessServices).filter(s=>s.active);
const schema=JSON.stringify({"@context":"https://schema.org","@graph":[
 {"@type":"CollectionPage","url":url,"name":"Servicii pentru petreceri copii București și Ilfov","description":"Hub AnimaParty pentru animatori, mascote, magician, picioroange, decorațiuni cu baloane și food stations.","isPartOf":{"@id":"https://animaparty.ro/#website"}},
 {"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"AnimaParty","item":"https://animaparty.ro/"},{"@type":"ListItem","position":2,"name":"Servicii","item":url}]},
 {"@type":"ItemList","itemListElement":active.map((s,i)=>({"@type":"ListItem","position":i+1,"name":s.name,"url":"https://animaparty.ro"+s.url}))}
]});
const groups=[
 {title:'Animație & personaje',items:['animatori','mascote','picioroange']},
 {title:'Spectacol & gustări',items:['magician','food_stations']},
 {title:'Decor & ambient',items:['decor']}
];
---
<Layout title="Servicii pentru Petreceri Copii București & Ilfov | AnimaParty" description="Servicii AnimaParty pentru petreceri și evenimente: animatori, mascote, picioroange, magician, decorațiuni cu baloane, vată de zahăr și popcorn." canonical={url} schema={schema}>
<main>
 <BatchHero kicker="Hub de servicii · București & Ilfov" title="Servicii pentru petreceri de copii și evenimente" lead="Aici alegi categoria de serviciu. Fiecare serviciu are propria pagină, astfel încât Google și utilizatorul să găsească o destinație clară, fără ca paginile să concureze inutil între ele." image="/hero-real.png" imageAlt="Petrecere de copii cu activități și decor" note="Hubul nu înlocuiește paginile de serviciu: le conectează și explică diferența dintre ele." primaryLabel="Vezi animatori București" primaryHref="/animatori-petreceri-copii-bucuresti/" secondaryLabel="Contact" secondaryHref="/contact/"/>
 {groups.map(group=><section class="batch-section"><div class="container"><div class="batch-heading"><h2>{group.title}</h2></div><div class="batch-grid-3">{group.items.map(id=>{const s=businessServices[id];return <article class="batch-card"><h3><a href={s.url} style="color:inherit;text-decoration:none">{s.name}</a></h3><p>{s.hubDescription}</p><p style="margin-top:16px"><a href={s.url}>Vezi pagina serviciului →</a></p></article>})}</div></div></section>)}
 <section class="batch-section alt"><div class="container"><div class="batch-heading"><h2>Cum alegi serviciile fără să aglomerezi programul</h2><p>Începe cu obiectivul principal al evenimentului, apoi adaugă doar serviciile care au rol diferit și pot fi integrate în timpul disponibil.</p></div><table class="decision-table"><thead><tr><th>Obiectiv</th><th>Pagina potrivită</th></tr></thead><tbody>
 <tr><td>Jocuri și coordonarea grupului de copii</td><td><a href="/animatori-petreceri-copii-bucuresti/">Animatori</a></td></tr>
 <tr><td>Moment vizual, fotografii, tort</td><td><a href="/mascote-petreceri-copii/">Mascote</a></td></tr>
 <tr><td>Impact vizual pentru spații mari / evenimente</td><td><a href="/animatori-pe-picioroange/">Picioroange</a></td></tr>
 <tr><td>Spectacol dedicat</td><td><a href="/magician-petreceri-copii/">Magician</a></td></tr>
 <tr><td>Fundal, intrare, heliu</td><td><a href="/decoratiuni-baloane-bucuresti/">Decorațiuni cu baloane</a></td></tr>
 <tr><td>Vată de zahăr sau popcorn</td><td><a href="/vata-de-zahar-popcorn-evenimente/">Food stations</a></td></tr>
 </tbody></table></div></section>
 <PhotoProof title="Atmosferă, personaje și decor" items={[
 {src:'/char-mascot.png',alt:'Mascotă la petrecere de copii',caption:'Mascote pentru momente vizuale și fotografii.'},
 {src:'/service-princess.png',alt:'Personaj tematic la petrecere de copii',caption:'Animație și personaje tematice.'},
 {src:'/hero-luxury.png',alt:'Decor cu baloane pentru eveniment',caption:'Decor pentru fundaluri și zone foto.'}
 ]}/>
 <SeoFooter/>
</main>
</Layout>
