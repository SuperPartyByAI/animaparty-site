---
import Layout from '../layouts/Layout.astro';
import BatchHero from '../components/BatchHero.astro';
import PhotoProof from '../components/PhotoProof.astro';
import RelatedServices from '../components/RelatedServices.astro';
import SeoFooter from '../components/SeoFooter.astro';
import { businessFacts } from '../data/business-facts';
const url='https://animaparty.ro/vata-de-zahar-popcorn-evenimente/';
const faq=[
 {q:'Pot alege doar vată de zahăr sau doar popcorn?',a:'Da. Configurația poate include unul dintre servicii sau ambele, în funcție de disponibilitate și oferta confirmată.'},
 {q:'Operatorul este inclus?',a:'Serviciul poate fi configurat cu sau fără operator, în funcție de pachetul confirmat.'},
 {q:'Consumabilele sunt incluse?',a:'Pachetele pot fi configurate cu sau fără consumabile; cantitatea și tipul se confirmă în ofertă.'},
 {q:'Este nevoie de curent electric?',a:'Necesarul tehnic depinde de echipamentul folosit și se confirmă înainte de eveniment. Trimite detalii despre locație.'},
 {q:'Există un număr nelimitat de porții?',a:'Nu publicăm o promisiune universală de porții nelimitate. Cantitatea și durata serviciului se stabilesc în oferta confirmată.'},
 {q:'Veniți în Ilfov?',a:businessFacts.transportIlfov}
];
const schema=JSON.stringify({"@context":"https://schema.org","@graph":[
 {"@type":"WebPage","url":url,"name":"Vată de zahăr și popcorn pentru evenimente București și Ilfov","inLanguage":"ro-RO"},
 {"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"AnimaParty","item":"https://animaparty.ro/"},{"@type":"ListItem","position":2,"name":"Vată de zahăr & popcorn","item":url}]},
 {"@type":"Service","name":"Vată de zahăr și popcorn pentru evenimente","provider":{"@id":"https://animaparty.ro/#organization"},"areaServed":["București","Ilfov"]},
 {"@type":"FAQPage","mainEntity":faq.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}}))}
]});
---
<Layout title="Vată de Zahăr & Popcorn Evenimente București & Ilfov | AnimaParty" description="Vată de zahăr și popcorn pentru evenimente în București și Ilfov. Configurații cu sau fără operator și consumabile, confirmate prin ofertă înainte de eveniment." canonical={url} schema={schema}>
<main>
 <BatchHero kicker="Food stations · evenimente" title="Vată de zahăr și popcorn pentru evenimente" lead="Alegi vată de zahăr, popcorn sau o configurație combinată. Operatorul, consumabilele, durata, necesarul tehnic și transportul se confirmă înainte de rezervare." image="/gallery-cake.png" imageAlt="Masă festivă la o petrecere de copii" note="Pagina tratează două servicii apropiate ca intenție; fiecare opțiune este explicată separat pentru a evita ambiguitatea." />
 <section class="batch-section"><div class="container"><div class="batch-heading"><h2>Alege configurația potrivită</h2><p>Nu presupunem că fiecare rezervare include automat operator, consumabile sau un număr fix de porții.</p></div><div class="batch-grid-3">
  <article class="batch-card"><h3>Vată de zahăr</h3><p>Serviciu separat, configurat după durata evenimentului, consumabile și modul de operare stabilit.</p></article>
  <article class="batch-card"><h3>Popcorn</h3><p>Serviciu separat, cu detalii despre operator, consumabile și cantitate confirmate înainte.</p></article>
  <article class="batch-card"><h3>Combinație</h3><p>Ambele servicii pot fi cerute împreună, dacă disponibilitatea și logistica permit.</p></article>
 </div></div></section>
 <section class="batch-section alt"><div class="container"><div class="batch-heading"><h2>Ce trebuie să apară într-o ofertă clară</h2></div><table class="decision-table"><thead><tr><th>Element</th><th>Ce confirmăm</th></tr></thead><tbody>
  <tr><td>serviciul ales</td><td>vată, popcorn sau ambele</td></tr>
  <tr><td>operator</td><td>dacă este inclus sau nu</td></tr>
  <tr><td>consumabile</td><td>tipul și cantitatea</td></tr>
  <tr><td>durata</td><td>intervalul serviciului</td></tr>
  <tr><td>necesar tehnic</td><td>cerințele echipamentului și accesul în locație</td></tr>
  <tr><td>transport</td><td>București sau cost confirmat pentru Ilfov</td></tr>
 </tbody></table></div></section>
 <section class="batch-section"><div class="container batch-grid-2"><article class="batch-card"><h2>Preț la cerere</h2><p>Prețul depinde de configurația concretă. Trimite serviciul, data, locația, durata și numărul estimat de invitați pentru o ofertă comparabilă.</p><p style="margin-top:16px"><a class="btn btn-whatsapp" href="https://wa.me/40792864811">Cere ofertă</a></p></article><article class="batch-card"><h2>Transport</h2><p>{businessFacts.transportBucuresti}</p><p style="margin-top:10px">{businessFacts.transportIlfov}</p></article></div></section>
 <PhotoProof title="Context vizual pentru petreceri și evenimente" lead="Imagini existente în prezentarea AnimaParty. Nu sunt folosite pentru a promite o anumită configurație de echipament." items={[
  {src:'/gallery-cake.png',alt:'Moment festiv la petrecere de copii',caption:'Food station-ul se integrează în programul evenimentului.'},
  {src:'/hero-real.png',alt:'Petrecere de copii în interior',caption:'Necesarul tehnic depinde de locație.'},
  {src:'/hero-bg-v4.jpg',alt:'Petrecere de copii în exterior',caption:'Pentru exterior se confirmă logistica înainte de ofertă.'}
 ]}/>
 <section class="batch-section alt"><div class="container"><div class="batch-heading"><h2>Întrebări frecvente — vată & popcorn</h2></div><div class="batch-grid-2">{faq.map(f=><details class="batch-card"><summary><strong>{f.q}</strong></summary><p style="margin-top:12px">{f.a}</p></details>)}</div></div></section>
 <RelatedServices items={[
  {title:'Animatori',href:'/animatori-petreceri-copii-bucuresti/',text:'Program de animație pentru grupul de copii.'},
  {title:'Decorațiuni cu baloane',href:'/decoratiuni-baloane-bucuresti/',text:'Decor pentru intrare, tort și zona foto.'},
  {title:'Magician',href:'/magician-petreceri-copii/',text:'Spectacol dedicat, separat de food station.'}
 ]}/>
 <SeoFooter/>
</main>
</Layout>
