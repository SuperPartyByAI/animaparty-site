---
import Layout from '../layouts/Layout.astro';
import BatchHero from '../components/BatchHero.astro';
import PhotoProof from '../components/PhotoProof.astro';
import RelatedServices from '../components/RelatedServices.astro';
import SeoFooter from '../components/SeoFooter.astro';
import { businessFacts } from '../data/business-facts';
const url='https://animaparty.ro/animatori-pe-picioroange/';
const faq=[
 {q:'Pentru ce tipuri de evenimente sunt potriviți animatorii pe picioroange?',a:'Sunt o opțiune vizuală pentru spații deschise, recepții, lansări, evenimente corporate sau momente în care vizibilitatea performerului este importantă.'},
 {q:'Pot participa și la interior?',a:'Posibilitatea se confirmă după înălțimea, accesul și suprafața spațiului. Trimite detalii despre locație înainte de rezervare.'},
 {q:'Cât de înalți sunt performerii?',a:'Înălțimea depinde de echipamentul folosit. Configurația exactă se confirmă pentru evenimentul solicitat.'},
 {q:'Cât costă?',a:'Prețul se stabilește la cerere, în funcție de numărul de performeri, durată, locație și format.'},
 {q:'Veniți în Ilfov?',a:businessFacts.transportIlfov}
];
const schema=JSON.stringify({"@context":"https://schema.org","@graph":[
 {"@type":"WebPage","url":url,"name":"Animatori pe Picioroange București și Ilfov","inLanguage":"ro-RO"},
 {"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"AnimaParty","item":"https://animaparty.ro/"},{"@type":"ListItem","position":2,"name":"Animatori pe Picioroange","item":url}]},
 {"@type":"Service","name":"Animatori pe picioroange","provider":{"@id":"https://animaparty.ro/#organization"},"areaServed":["București","Ilfov"]},
 {"@type":"FAQPage","mainEntity":faq.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}}))}
]});
---
<Layout title="Animatori pe Picioroange București & Ilfov | AnimaParty" description="Animatori pe picioroange pentru evenimente în București și Ilfov. Verificăm spațiul, accesul, numărul de performeri, durata și prețul înainte de rezervare." canonical={url} schema={schema}>
<main>
 <BatchHero kicker="Picioroange · evenimente cu impact vizual" title="Animatori pe picioroange în București și Ilfov" lead="Un serviciu pentru evenimente în care prezența vizuală contează. Înainte de ofertă verificăm spațiul, accesul și formatul, fără să presupunem că aceeași configurație funcționează în orice locație." image="/gallery-dance.png" imageAlt="Atmosferă de eveniment cu public" note="Înălțimea și configurația echipamentului se confirmă pentru eveniment; nu publicăm dimensiuni neverificate." />
 <section class="batch-section"><div class="container"><div class="batch-heading"><h2>Unde are sens acest serviciu</h2><p>Picioroangele nu înlocuiesc animatorul pentru jocuri de copii. Rolul lor este în principal vizual și de prezență în spațiu.</p></div><div class="batch-grid-3">
  <article class="batch-card"><h3>Recepție & intrare</h3><p>Moment vizual pentru sosirea invitaților sau deschiderea evenimentului.</p></article>
  <article class="batch-card"><h3>Evenimente open-air</h3><p>Potrivite când spațiul este suficient și condițiile locației sunt confirmate.</p></article>
  <article class="batch-card"><h3>Corporate & lansări</h3><p>Prezență vizuală pentru evenimente cu public și zone de circulație largi.</p></article>
 </div></div></section>
 <section class="batch-section alt"><div class="container"><div class="batch-heading"><h2>Checklist înainte de ofertă</h2><p>Aceste informații sunt mai utile decât o listă generică de promisiuni tehnice.</p></div><table class="decision-table"><thead><tr><th>Ce ne spui</th><th>Ce verificăm</th></tr></thead><tbody>
  <tr><td>interior / exterior</td><td>dacă spațiul permite configurația solicitată</td></tr>
  <tr><td>suprafața și accesul</td><td>condițiile de participare și traseul performerilor</td></tr>
  <tr><td>numărul de invitați</td><td>numărul de performeri potrivit formatului</td></tr>
  <tr><td>durata momentului</td><td>programul și costul</td></tr>
  <tr><td>tipul evenimentului</td><td>costumul și stilul de interacțiune disponibile</td></tr>
 </tbody></table></div></section>
 <section class="batch-section"><div class="container batch-grid-2"><article class="batch-card"><h2>Preț la cerere</h2><p>Nu afișăm un tarif numeric fără o configurație verificată. Numărul de performeri, durata, locația și logistica influențează oferta.</p><p style="margin-top:16px"><a class="btn btn-whatsapp" href="https://wa.me/40792864811">Cere ofertă</a></p></article><article class="batch-card"><h2>Transport</h2><p>{businessFacts.transportBucuresti}</p><p style="margin-top:10px">{businessFacts.transportIlfov}</p></article></div></section>
 <PhotoProof title="Atmosfera evenimentului" lead="Imagini existente în prezentarea AnimaParty; pagina nu pretinde că aceste cadre reprezintă echipamentul exact de picioroange." items={[
  {src:'/gallery-dance.png',alt:'Public la eveniment',caption:'Exemplu de atmosferă cu public.'},
  {src:'/hero-bg-v4.jpg',alt:'Eveniment de copii în exterior',caption:'Spațiu exterior folosit ca exemplu de context.'},
  {src:'/hero-real.png',alt:'Petrecere de copii în interior',caption:'La interior, condițiile spațiului trebuie verificate înainte.'}
 ]}/>
 <section class="batch-section alt"><div class="container"><div class="batch-heading"><h2>Întrebări frecvente — picioroange</h2></div><div class="batch-grid-2">{faq.map(f=><details class="batch-card"><summary><strong>{f.q}</strong></summary><p style="margin-top:12px">{f.a}</p></details>)}</div></div></section>
 <RelatedServices items={[
  {title:'Animatori pentru copii',href:'/animatori-petreceri-copii-bucuresti/',text:'Pentru jocuri și coordonarea grupului.'},
  {title:'Mascote',href:'/mascote-petreceri-copii/',text:'Pentru o apariție tematică și fotografii.'},
  {title:'Decorațiuni cu baloane',href:'/decoratiuni-baloane-bucuresti/',text:'Pentru intrare, fundal și zone foto.'}
 ]}/>
 <SeoFooter/>
</main>
</Layout>
