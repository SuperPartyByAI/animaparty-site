---
import Layout from '../layouts/Layout.astro';
import BatchHero from '../components/BatchHero.astro';
import PhotoProof from '../components/PhotoProof.astro';
import RelatedServices from '../components/RelatedServices.astro';
import SeoFooter from '../components/SeoFooter.astro';
import { businessFacts } from '../data/business-facts';
const url='https://animaparty.ro/mascote-petreceri-copii/';
const faq=[
 {q:'Mascota vorbește?',a:'Mascotele sunt prezentate ca prezențe non-verbale: interacțiunea se face prin gesturi, dans și fotografii.'},
 {q:'Mascota face jocuri sau face painting?',a:'Pentru jocuri coordonate și activități de animație recomandăm un animator. Rolul mascotei este în principal vizual.'},
 {q:'Cât costă închirierea unei mascote?',a:'Prețul se confirmă la cerere, după personaj, durată, locație și disponibilitate.'},
 {q:'Cât timp poate rămâne mascota?',a:'Durata se stabilește în funcție de formatul evenimentului și configurația confirmată.'},
 {q:'Veniți în București și Ilfov?',a:`${businessFacts.transportBucuresti} ${businessFacts.transportIlfov}`}
];
const schema=JSON.stringify({"@context":"https://schema.org","@graph":[
 {"@type":"WebPage","url":url,"name":"Închiriere Mascote Petreceri Copii București și Ilfov","inLanguage":"ro-RO"},
 {"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"AnimaParty","item":"https://animaparty.ro/"},{"@type":"ListItem","position":2,"name":"Mascote","item":url}]},
 {"@type":"Service","name":"Închiriere mascote pentru petreceri copii","provider":{"@id":"https://animaparty.ro/#organization"},"areaServed":["București","Ilfov"]},
 {"@type":"FAQPage","mainEntity":faq.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}}))}
]});
---
<Layout title="Închiriere Mascote Petreceri Copii București & Ilfov | AnimaParty" description="Mascote pentru petreceri de copii în București și Ilfov: întâmpinarea invitaților, fotografii și momentul tortului. Personajul, durata și prețul se confirmă la cerere." canonical={url} schema={schema}>
<main>
 <BatchHero kicker="Mascote · București & Ilfov" title="Închiriere mascote pentru petreceri de copii" lead="Mascota este un moment vizual: poate întâmpina invitații, apărea la tort și participa la fotografii. Pentru jocuri și activități coordonate, serviciul potrivit este animația cu animator." image="/char-mascot.png" imageAlt="Mascotă la o petrecere de copii" note="Personajul, durata, locația și prețul se confirmă înainte de rezervare." />
 <section class="batch-section"><div class="container"><div class="batch-heading"><h2>Ce rol are mascota la eveniment</h2><p>Pagina aceasta este dedicată intenției „închiriere mascotă”, separat de serviciul de animator.</p></div><div class="batch-grid-3">
  <article class="batch-card"><h3>Întâmpinarea invitaților</h3><p>O apariție vizuală la sosire sau într-un moment stabilit în program.</p></article>
  <article class="batch-card"><h3>Momentul tortului</h3><p>Mascota poate fi integrată în momentul festiv, conform configurației stabilite.</p></article>
  <article class="batch-card"><h3>Fotografii</h3><p>Interacțiune non-verbală și fotografii cu sărbătoritul și invitații.</p></article>
 </div></div></section>
 <section class="batch-section alt"><div class="container"><div class="batch-heading"><h2>Mascotă sau animator?</h2><p>Alegerea depinde de ce vrei să se întâmple la petrecere.</p></div><table class="decision-table"><thead><tr><th>Dacă vrei...</th><th>Alege...</th></tr></thead><tbody>
  <tr><td>apariție tematică, poze, tort</td><td><strong>Mascotă</strong></td></tr>
  <tr><td>jocuri, concursuri și coordonarea grupului</td><td><a href="/animatori-petreceri-copii-bucuresti/"><strong>Animator</strong></a></td></tr>
  <tr><td>ambele momente în aceeași petrecere</td><td>o configurație combinată, confirmată înainte de rezervare</td></tr>
 </tbody></table></div></section>
 <section class="batch-section"><div class="container batch-grid-2"><article class="batch-card"><h2>Ce ne trimiți</h2><ul><li>personajul dorit</li><li>data și ora</li><li>locația</li><li>momentul în care vrei apariția</li><li>durata dorită</li></ul></article><article class="batch-card"><h2>Ce primești înainte de confirmare</h2><ul><li>disponibilitatea personajului</li><li>durata și formatul</li><li>prețul exact</li><li>transportul, unde este cazul</li><li>detaliile de acces</li></ul></article></div></section>
 <PhotoProof title="Exemple vizuale de personaje" lead="Imagini folosite în prezentarea actuală AnimaParty." items={[
  {src:'/char-mascot.png',alt:'Mascotă tematică la petrecere',caption:'Apariție vizuală și fotografii.'},
  {src:'/animaparty-mascota-fairy.jpg',alt:'Personaj tematic la eveniment de copii',caption:'Personajul exact se confirmă după disponibilitate.'},
  {src:'/char-superhero.png',alt:'Personaj supererou la petrecere',caption:'Pentru jocuri coordonate, verifică și serviciul de animator.'}
 ]}/>
 <section class="batch-section alt"><div class="container"><div class="batch-heading"><h2>Întrebări frecvente despre mascote</h2></div><div class="batch-grid-2">{faq.map(f=><details class="batch-card"><summary><strong>{f.q}</strong></summary><p style="margin-top:12px">{f.a}</p></details>)}</div></div></section>
 <RelatedServices items={[
  {title:'Animatori București',href:'/animatori-petreceri-copii-bucuresti/',text:'Pentru jocuri, activități și coordonarea grupului.'},
  {title:'Animatori Ilfov',href:'/animatori-petreceri-copii-ilfov/',text:'Program de animație cu transport confirmat după adresă.'},
  {title:'Decorațiuni cu baloane',href:'/decoratiuni-baloane-bucuresti/',text:'Fundal sau decor pentru zona de fotografii și tort.'}
 ]}/>
 <SeoFooter/>
</main>
</Layout>
