---
import Layout from '../layouts/Layout.astro';
import BatchHero from '../components/BatchHero.astro';
import Packages from '../components/Packages.astro';
import PhotoProof from '../components/PhotoProof.astro';
import RelatedServices from '../components/RelatedServices.astro';
import SeoFooter from '../components/SeoFooter.astro';
import StickyBottomCta from '../components/StickyBottomCta.astro';
import { faqIlfov } from '../data/faqIlfov';
import { pricedTiers } from '../data/pricing';
import { businessFacts } from '../data/business-facts';
const url='https://animaparty.ro/animatori-petreceri-copii-ilfov/';
const schema=JSON.stringify({"@context":"https://schema.org","@graph":[
 {"@type":"WebPage","@id":url+'#webpage',"url":url,"name":"Animatori Petreceri Copii Ilfov","description":"Animatori pentru petreceri de copii în Ilfov. Verificăm localitatea, adresa, disponibilitatea și costul deplasării înainte de rezervare.","inLanguage":"ro-RO","isPartOf":{"@id":"https://animaparty.ro/#website"}},
 {"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"AnimaParty","item":"https://animaparty.ro/"},{"@type":"ListItem","position":2,"name":"Animatori Ilfov","item":url}]},
 {"@type":"Service","name":"Animatori petreceri copii Ilfov","provider":{"@id":"https://animaparty.ro/#organization"},"areaServed":"Ilfov","offers":pricedTiers.map(p=>({"@type":"Offer","price":p.price,"priceCurrency":"RON","name":p.offerName,"url" : url}))},
 {"@type":"FAQPage","mainEntity":faqIlfov.map(f=>({"@type":"Question","name":f.question,"acceptedAnswer":{"@type":"Answer","text":f.answer}}))}
]});
const proof=[
 {src:'/hero-bg-v4.jpg',alt:'Petrecere de copii în aer liber',caption:'Pentru exterior, programul se adaptează spațiului și condițiilor locației.'},
 {src:'/animaparty-jocuri-interactive.webp',alt:'Activitate interactivă cu copii la eveniment',caption:'Configurația programului se alege după grupa de vârstă și locație.'},
 {src:'/gallery-dance.png',alt:'Copii dansând la o petrecere',caption:'Ritmul programului se stabilește după timpul rezervat.'}
];
---
<Layout title="Animatori Petreceri Copii Ilfov | Deplasare & Pachete | AnimaParty" description="Animatori petreceri copii în Ilfov. Pachete afișate, localități deservite în funcție de disponibilitate și cost de transport confirmat înainte de rezervare." canonical={url} schema={schema}>
<main>
  <BatchHero kicker="Ilfov · rezervare după adresă" title="Animatori Petreceri Copii Ilfov" lead="Pentru Ilfov verificăm întâi localitatea, adresa și intervalul. Pachetele de animație rămân cele afișate pe site, iar costul deplasării este comunicat înainte de confirmarea rezervării." image="/hero-bg-v4.jpg" imageAlt="Petrecere de copii în aer liber în zona București-Ilfov" note="Exemple de localități pentru care putem verifica disponibilitatea: Otopeni, Voluntari, Popești-Leordeni, Bragadiru și Chiajna." />

  <section class="batch-section">
    <div class="container">
      <div class="batch-heading"><h2>Cum funcționează o rezervare în Ilfov</h2><p>Diferența față de București este logistica deplasării. De aceea această pagină tratează intenția Ilfov separat, fără să copieze landing page-ul București.</p></div>
      <div class="batch-grid-3">
        <article class="batch-card"><h3>1. Localitatea și adresa</h3><p>Avem nevoie de adresa exactă pentru verificarea deplasării și a intervalului.</p></article>
        <article class="batch-card"><h3>2. Programul dorit</h3><p>Alegi durata și numărul de animatori, apoi ajustăm activitățile după spațiu și vârste.</p></article>
        <article class="batch-card"><h3>3. Confirmarea costului</h3><p>{businessFacts.transportIlfov}</p></article>
      </div>
    </div>
  </section>

  <section class="batch-section alt">
    <div class="container">
      <div class="batch-heading"><h2>Localități pentru care poți cere verificarea disponibilității</h2><p>Lista este orientativă, nu o promisiune de disponibilitate permanentă. Confirmarea se face pentru data și adresa concretă.</p></div>
      <div class="batch-grid-3">
        {['Otopeni','Voluntari','Popești-Leordeni','Bragadiru','Chiajna','Alte localități din Ilfov'].map(x=><article class="batch-card"><h3>{x}</h3><p>Trimite adresa și intervalul pentru confirmare.</p></article>)}
      </div>
    </div>
  </section>

  <Packages subtitle="Prețurile pachetelor de animație sunt cele afișate; pentru Ilfov, deplasarea se confirmă separat înainte de rezervare." />

  <section class="batch-section">
    <div class="container">
      <div class="batch-heading"><h2>Checklist logistic pentru Ilfov</h2><p>Informațiile de mai jos reduc neclaritățile înainte de eveniment și ne ajută să alegem programul potrivit locației.</p></div>
      <table class="decision-table"><thead><tr><th>Informație</th><th>De ce contează</th></tr></thead><tbody>
        <tr><td><strong>Adresa exactă</strong></td><td>Pentru traseu, interval și costul deplasării.</td></tr>
        <tr><td><strong>Casă / curte / restaurant / loc de joacă</strong></td><td>Pentru alegerea tipului de activități.</td></tr>
        <tr><td><strong>Interior sau exterior</strong></td><td>Pentru ritmul programului și spațiul necesar.</td></tr>
        <tr><td><strong>Număr și vârste copii</strong></td><td>Pentru recomandarea numărului de animatori.</td></tr>
        <tr><td><strong>Ora tortului</strong></td><td>Pentru integrarea momentului în program.</td></tr>
      </tbody></table>
    </div>
  </section>

  <PhotoProof title="Exemple vizuale pentru formatul petrecerii" lead="Imagini existente în prezentarea AnimaParty, folosite pentru a ilustra tipuri de activități și spații." items={proof}/>

  <section class="batch-section alt" id="faq"><div class="container"><div class="batch-heading"><h2>Întrebări frecvente — Ilfov</h2></div><div class="batch-grid-2">{faqIlfov.map(f=><details class="batch-card"><summary><strong>{f.question}</strong></summary><p style="margin-top:12px">{f.answer}</p></details>)}</div></div></section>
  <RelatedServices items={[
    {title:'Animatori București',href:'/animatori-petreceri-copii-bucuresti/',text:'Pagina locală dedicată rezervărilor din Sectoarele 1-6.'},
    {title:'Mascote',href:'/mascote-petreceri-copii/',text:'Prezență tematică pentru fotografii și momentul tortului.'},
    {title:'Decorațiuni cu baloane',href:'/decoratiuni-baloane-bucuresti/',text:'Decor configurat după locație și concept.'}
  ]}/>
  <SeoFooter/><StickyBottomCta/>
</main>
</Layout>
