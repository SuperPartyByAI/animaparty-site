---
import Layout from '../layouts/Layout.astro';
import BatchHero from '../components/BatchHero.astro';
import PhotoProof from '../components/PhotoProof.astro';
import RelatedServices from '../components/RelatedServices.astro';
import SeoFooter from '../components/SeoFooter.astro';
import { businessFacts } from '../data/business-facts';
const url='https://animaparty.ro/magician-petreceri-copii/';
const faq=[
 {q:'Pentru ce vârste este potrivit spectacolul?',a:'Formatul se adaptează în funcție de vârsta participanților; configurația exactă se confirmă înainte de rezervare.'},
 {q:'Cât durează spectacolul?',a:'Durata se confirmă în funcție de programul solicitat. Nu publicăm o durată fixă universală.'},
 {q:'Magicianul este același lucru cu animatorul?',a:'Nu. Magicianul susține un spectacol dedicat; animatorul coordonează jocuri și activități de grup pe parcursul programului de animație.'},
 {q:'Cât costă?',a:'Prețul se confirmă la cerere după format, durată, locație și disponibilitate.'},
 {q:'Veniți în București și Ilfov?',a:`${businessFacts.transportBucuresti} ${businessFacts.transportIlfov}`}
];
const schema=JSON.stringify({"@context":"https://schema.org","@graph":[
 {"@type":"WebPage","url":url,"name":"Magician Petreceri Copii București și Ilfov","inLanguage":"ro-RO"},
 {"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"AnimaParty","item":"https://animaparty.ro/"},{"@type":"ListItem","position":2,"name":"Magician","item":url}]},
 {"@type":"Service","name":"Magician pentru petreceri de copii","provider":{"@id":"https://animaparty.ro/#organization"},"areaServed":["București","Ilfov"]},
 {"@type":"FAQPage","mainEntity":faq.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}}))}
]});
---
<Layout title="Magician Petreceri Copii București & Ilfov | AnimaParty" description="Magician pentru petreceri de copii în București și Ilfov. Spectacolul se adaptează vârstei și formatului; durata, disponibilitatea și prețul se confirmă la cerere." canonical={url} schema={schema}>
<main>
 <BatchHero kicker="Spectacol dedicat · București & Ilfov" title="Magician pentru petreceri de copii" lead="Magicianul este un moment de spectacol, nu o copie a serviciului de animator. Înainte de rezervare confirmăm vârsta publicului, spațiul, durata, formatul și costul." image="/animaparty-petrecere-copii-03.png" imageAlt="Moment de spectacol la o petrecere de copii" note="Imagine din prezentarea existentă a site-ului; formatul exact al spectacolului se confirmă la rezervare." />
 <section class="batch-section"><div class="container"><div class="batch-heading"><h2>Ce diferențiază un spectacol de magie</h2><p>Pagina aceasta răspunde intenției de „magician”, fără să canibalizeze pagina de animatori.</p></div><div class="batch-grid-3">
  <article class="batch-card"><h3>Moment structurat</h3><p>Spectacolul are un interval și un format confirmate înainte, distincte de jocurile animatorului.</p></article>
  <article class="batch-card"><h3>Participare adaptată</h3><p>Gradul de interacțiune se stabilește în funcție de vârsta participanților și tipul evenimentului.</p></article>
  <article class="batch-card"><h3>Locație verificată</h3><p>Spune-ne dacă evenimentul este acasă, la restaurant, la loc de joacă sau într-o instituție.</p></article>
 </div></div></section>
 <section class="batch-section alt"><div class="container"><div class="batch-heading"><h2>Ce trebuie stabilit înainte de ofertă</h2></div><table class="decision-table"><thead><tr><th>Informație</th><th>De ce contează</th></tr></thead><tbody>
  <tr><td>vârsta participanților</td><td>pentru adaptarea formatului</td></tr>
  <tr><td>numărul aproximativ</td><td>pentru modul de interacțiune</td></tr>
  <tr><td>tipul locației</td><td>pentru spațiul de spectacol</td></tr>
  <tr><td>durata dorită</td><td>pentru configurația și costul final</td></tr>
  <tr><td>momentul în program</td><td>pentru integrarea cu tortul sau alte servicii</td></tr>
 </tbody></table></div></section>
 <section class="batch-section"><div class="container batch-grid-2"><article class="batch-card"><h2>Preț la cerere</h2><p>Nu afișăm o durată sau un preț universal fără o configurație confirmată. Trimite data, locația, vârstele și intervalul dorit.</p><p style="margin-top:16px"><a class="btn btn-whatsapp" href="https://wa.me/40792864811">Cere disponibilitatea</a></p></article><article class="batch-card"><h2>Transport</h2><p>{businessFacts.transportBucuresti}</p><p style="margin-top:10px">{businessFacts.transportIlfov}</p></article></div></section>
 <PhotoProof title="Atmosferă de spectacol și petrecere" lead="Imagini deja existente în prezentarea AnimaParty, folosite pentru context vizual." items={[
  {src:'/animaparty-petrecere-copii-03.png',alt:'Moment de spectacol cu copii',caption:'Exemplu vizual de moment de spectacol.'},
  {src:'/hero-real.png',alt:'Petrecere de copii în interior',caption:'Spațiul influențează formatul.'},
  {src:'/gallery-cake.png',alt:'Momentul tortului la petrecere',caption:'Spectacolul poate fi integrat într-un program mai larg.'}
 ]}/>
 <section class="batch-section alt"><div class="container"><div class="batch-heading"><h2>Întrebări frecvente — magician</h2></div><div class="batch-grid-2">{faq.map(f=><details class="batch-card"><summary><strong>{f.q}</strong></summary><p style="margin-top:12px">{f.a}</p></details>)}</div></div></section>
 <RelatedServices items={[
  {title:'Animatori',href:'/animatori-petreceri-copii-bucuresti/',text:'Pentru jocuri și coordonarea grupului pe durata programului.'},
  {title:'Mascote',href:'/mascote-petreceri-copii/',text:'Pentru un moment vizual și fotografii.'},
  {title:'Vată de zahăr & popcorn',href:'/vata-de-zahar-popcorn-evenimente/',text:'Serviciu separat de gustări pentru eveniment.'}
 ]}/>
 <SeoFooter/>
</main>
</Layout>
