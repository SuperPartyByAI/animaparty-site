---
import Layout from '../layouts/Layout.astro';
import BatchHero from '../components/BatchHero.astro';
import Packages from '../components/Packages.astro';
import PhotoProof from '../components/PhotoProof.astro';
import RelatedServices from '../components/RelatedServices.astro';
import SeoFooter from '../components/SeoFooter.astro';
import StickyBottomCta from '../components/StickyBottomCta.astro';
import { faqBucuresti } from '../data/faqBucuresti';
import { pricedTiers } from '../data/pricing';
import { businessFacts } from '../data/business-facts';

const url='https://animaparty.ro/animatori-petreceri-copii-bucuresti/';
const offers=pricedTiers.map(pkg=>({"@type":"Offer","price":pkg.price,"priceCurrency":"RON","name":pkg.offerName,"url" : url}));
const schema=JSON.stringify({"@context":"https://schema.org","@graph":[
 {"@type":"WebPage","@id":url+'#webpage',"url":url,"name":"Animatori Petreceri Copii București","description":"Animatori pentru petreceri de copii în București, Sectoarele 1-6. Pachete afișate, rezervare pe WhatsApp și program adaptat spațiului.","inLanguage":"ro-RO","isPartOf":{"@id":"https://animaparty.ro/#website"}},
 {"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"AnimaParty","item":"https://animaparty.ro/"},{"@type":"ListItem","position":2,"name":"Animatori București","item":url}]},
 {"@type":"Service","name":"Animatori petreceri copii București","provider":{"@id":"https://animaparty.ro/#organization"},"areaServed":["București","Sector 1","Sector 2","Sector 3","Sector 4","Sector 5","Sector 6"],"offers":offers},
 {"@type":"FAQPage","mainEntity":faqBucuresti.map(f=>({"@type":"Question","name":f.question,"acceptedAnswer":{"@type":"Answer","text":f.answer}}))}
]});
const proof=[
 {src:'/hero-bucuresti.webp',alt:'Petrecere de copii în aer liber cu animator',caption:'Exemplu vizual din prezentarea AnimaParty.'},
 {src:'/service-games.png',alt:'Jocuri coordonate la o petrecere de copii',caption:'Activitățile se aleg după spațiu și grupa de vârstă.'},
 {src:'/service-face-painting.png',alt:'Pictură pe față la petrecere de copii',caption:'Face painting-ul se confirmă în funcție de pachet și timpul disponibil.'}
];
---
<Layout title="Animatori Petreceri Copii București | Pachete & Prețuri | AnimaParty" description="Animatori petreceri copii în București, Sectoarele 1-6. Pachete afișate, deplasare inclusă în București și rezervare rapidă pe WhatsApp." canonical={url} schema={schema}>
<main>
  <BatchHero kicker="București · Sectoarele 1-6" title="Animatori Petreceri Copii București" lead="Alegi personajul și programul, iar noi confirmăm disponibilitatea, spațiul și detaliile înainte de rezervare. Deplasarea este inclusă pentru evenimentele din Sectoarele 1-6." image="/hero-bucuresti.webp" imageAlt="Animator la petrecere de copii în București" note="Pagină dedicată rezervărilor din București — separată de ghidul informativ și de pagina Ilfov." />

  <section class="batch-section">
    <div class="container">
      <div class="batch-heading"><h2>Ce trebuie să știi înainte să rezervi în București</h2><p>Pagina aceasta răspunde intenției locale: unde venim, cât costă pachetele afișate și ce informații sunt necesare ca programul să fie potrivit locației.</p></div>
      <div class="batch-grid-3">
        <article class="batch-card"><h3>Sectoarele 1-6</h3><p>{businessFacts.transportBucuresti}</p></article>
        <article class="batch-card"><h3>Pachete clare</h3><p>Prețurile afișate sunt totaluri per pachet. Configurația exactă se confirmă înainte de rezervare.</p></article>
        <article class="batch-card"><h3>Program adaptat locației</h3><p>Spune-ne dacă evenimentul este acasă, la restaurant, în grădiniță, la loc de joacă sau în aer liber.</p></article>
      </div>
    </div>
  </section>

  <Packages subtitle="Pachetele de animație pentru București folosesc aceleași prețuri afișate pe site. Deplasarea este inclusă în Sectoarele 1-6." />

  <section class="batch-section alt">
    <div class="container">
      <div class="batch-heading"><h2>Alege programul după tipul locației</h2><p>Nu folosim aceeași formulă în orice spațiu. Locația schimbă ritmul, mișcarea și activitățile care pot fi făcute confortabil.</p></div>
      <table class="decision-table">
        <thead><tr><th>Locație</th><th>Ce verificăm</th><th>Ce ajută programul</th></tr></thead>
        <tbody>
          <tr><td><strong>Apartament</strong></td><td>Spațiul liber, vecinătatea și accesul</td><td>Jocuri compacte, activități fără alergare excesivă</td></tr>
          <tr><td><strong>Restaurant / terasă</strong></td><td>Zona dedicată copiilor și circulația personalului</td><td>Program structurat într-un perimetru clar</td></tr>
          <tr><td><strong>Grădiniță / școală</strong></td><td>Acordul instituției, ora și regulile de acces</td><td>Activități potrivite grupului și timpului disponibil</td></tr>
          <tr><td><strong>Loc de joacă / curte</strong></td><td>Ce oferă deja locația și suprafața disponibilă</td><td>Jocuri mai dinamice când spațiul permite</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="batch-section">
    <div class="container batch-grid-2">
      <article class="batch-card"><h2>Ce ne trimiți pe WhatsApp</h2><ul><li>data și ora</li><li>adresa exactă</li><li>tipul locației</li><li>numărul estimat și vârstele copiilor</li><li>personajul sau serviciul dorit</li></ul></article>
      <article class="batch-card"><h2>Ce confirmăm noi</h2><ul><li>disponibilitatea</li><li>configurația programului</li><li>activitățile potrivite timpului</li><li>eventualele servicii extra</li><li>ora și persoana de contact</li></ul></article>
    </div>
  </section>

  <PhotoProof title="Cum arată atmosfera unei petreceri" lead="Folosim imaginile deja existente în prezentarea AnimaParty; ele ajută la înțelegerea tipului de atmosferă și activități." items={proof} />

  <section class="batch-section alt" id="faq">
    <div class="container"><div class="batch-heading"><h2>Întrebări frecvente — București</h2></div><div class="batch-grid-2">{faqBucuresti.map(f=><details class="batch-card"><summary><strong>{f.question}</strong></summary><p style="margin-top:12px">{f.answer}</p></details>)}</div></div>
  </section>

  <RelatedServices items={[
    {title:'Mascote',href:'/mascote-petreceri-copii/',text:'Pentru întâmpinarea invitaților, fotografii și momentul tortului.'},
    {title:'Decorațiuni cu baloane',href:'/decoratiuni-baloane-bucuresti/',text:'Arcade, heliu și fundaluri foto configurate după concept.'},
    {title:'Magician',href:'/magician-petreceri-copii/',text:'Spectacol separat, adaptat vârstei și formatului evenimentului.'}
  ]} />
  <SeoFooter/><StickyBottomCta/>
</main>
</Layout>
