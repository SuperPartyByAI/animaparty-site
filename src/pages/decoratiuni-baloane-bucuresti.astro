---
import Layout from '../layouts/Layout.astro';
import BatchHero from '../components/BatchHero.astro';
import PhotoProof from '../components/PhotoProof.astro';
import RelatedServices from '../components/RelatedServices.astro';
import SeoFooter from '../components/SeoFooter.astro';
import { businessFacts } from '../data/business-facts';
const url='https://animaparty.ro/decoratiuni-baloane-bucuresti/';
const faq=[
 {q:'Ce tipuri de decor pot cere?',a:'Poți solicita arcade organice, aranjamente cu heliu și fundaluri sau panouri foto. Configurația finală depinde de concept și disponibilitate.'},
 {q:'Pot alege culorile?',a:'Da. Paleta cromatică se stabilește înainte de ofertă, în funcție de temă și disponibilitatea materialelor.'},
 {q:'Cât durează montajul?',a:'Timpul de montaj se stabilește după dimensiunea, complexitatea decorului și accesul la locație.'},
 {q:'Cât rezistă baloanele cu heliu?',a:'Durata de plutire variază în funcție de tipul balonului, tratament și condițiile de temperatură; nu publicăm o durată garantată universală.'},
 {q:'Montajul este inclus?',a:'Manopera, montajul și logistica se confirmă în oferta transmisă pentru configurația solicitată.'},
 {q:'Lucrați și în Ilfov?',a:businessFacts.transportIlfov}
];
const schema=JSON.stringify({"@context":"https://schema.org","@graph":[
 {"@type":"WebPage","url":url,"name":"Decorațiuni Baloane București și Ilfov","inLanguage":"ro-RO"},
 {"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"AnimaParty","item":"https://animaparty.ro/"},{"@type":"ListItem","position":2,"name":"Decorațiuni baloane","item":url}]},
 {"@type":"Service","name":"Decorațiuni cu baloane","provider":{"@id":"https://animaparty.ro/#organization"},"areaServed":["București","Ilfov"]},
 {"@type":"FAQPage","mainEntity":faq.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}}))}
]});
---
<Layout title="Decorațiuni Baloane București & Ilfov | Arcade, Heliu | AnimaParty" description="Decorațiuni cu baloane în București și Ilfov: arcade organice, aranjamente cu heliu și fundaluri foto. Conceptul, montajul, logistica și prețul se confirmă prin ofertă." canonical={url} schema={schema}>
<main>
 <BatchHero kicker="Decor · arcade · heliu · photo corner" title="Decorațiuni cu baloane în București și Ilfov" lead="Pornim de la locație, dimensiunea zonei, paleta cromatică și rolul decorului. Oferta se construiește pentru configurația cerută, nu din promisiuni generale despre montaj sau durată." image="/hero-luxury.png" imageAlt="Decor cu baloane pentru petrecere" note="Conceptul vizual și logistica se confirmă înainte de rezervare." />
 <section class="batch-section"><div class="container"><div class="batch-heading"><h2>Ce putem configura</h2><p>Fiecare tip de decor are o funcție diferită în spațiu.</p></div><div class="batch-grid-3">
  <article class="batch-card"><h3>Arcade organice</h3><p>Pentru intrări, zone de tort sau delimitarea vizuală a unui punct important din locație.</p></article>
  <article class="batch-card"><h3>Heliu</h3><p>Buchete, cifre sau litere, în funcție de temă și materialele disponibile.</p></article>
  <article class="batch-card"><h3>Fundal foto</h3><p>Panou sau structură decorată pentru fotografii și zona aniversară.</p></article>
 </div></div></section>
 <PhotoProof title="Direcții vizuale pentru decor" lead="Imagini deja folosite în prezentarea AnimaParty, utile pentru a discuta stilul, cromatica și densitatea decorului." items={[
  {src:'/hero-luxury.png',alt:'Arcadă și decor cu baloane în culori pastel',caption:'Exemplu de decor pentru zona de tort.'},
  {src:'/gallery-lux-2.png',alt:'Fundal elegant pentru eveniment',caption:'Exemplu de compoziție pentru fundal foto.'},
  {src:'/gallery-lux-3.png',alt:'Masă de eveniment decorată',caption:'Paleta și elementele se stabilesc după concept.'}
 ]}/>
 <section class="batch-section alt"><div class="container"><div class="batch-heading"><h2>Ce influențează oferta</h2><p>În locul unui „preț de la” greu de comparat, oferta trebuie să descrie exact configurația.</p></div><table class="decision-table"><thead><tr><th>Factor</th><th>Ce schimbă</th></tr></thead><tbody>
  <tr><td>dimensiunea decorului</td><td>cantitatea de materiale și timpul de lucru</td></tr>
  <tr><td>tipul baloanelor</td><td>compoziția și aspectul</td></tr>
  <tr><td>structura / panoul</td><td>montajul și accesul necesar</td></tr>
  <tr><td>locația</td><td>transportul și logistica</td></tr>
  <tr><td>interior / exterior</td><td>alegerea configurației și condițiile de montaj</td></tr>
 </tbody></table></div></section>
 <section class="batch-section"><div class="container batch-grid-2"><article class="batch-card"><h2>Ce ne trimiți pentru ofertă</h2><ul><li>data și locația</li><li>fotografie sau dimensiuni ale zonei</li><li>culorile / tema</li><li>tipul de decor dorit</li><li>ora la care spațiul este disponibil pentru montaj</li></ul></article><article class="batch-card"><h2>Transport & montaj</h2><p>{businessFacts.transportBucuresti}</p><p style="margin-top:10px">{businessFacts.transportIlfov}</p><p style="margin-top:10px">Manopera și montajul se confirmă în oferta configurației solicitate.</p></article></div></section>
 <section class="batch-section alt"><div class="container"><div class="batch-heading"><h2>Întrebări frecvente — decorațiuni</h2></div><div class="batch-grid-2">{faq.map(f=><details class="batch-card"><summary><strong>{f.q}</strong></summary><p style="margin-top:12px">{f.a}</p></details>)}</div></div></section>
 <RelatedServices items={[
  {title:'Animatori',href:'/animatori-petreceri-copii-bucuresti/',text:'Program de animație separat de partea de decor.'},
  {title:'Mascote',href:'/mascote-petreceri-copii/',text:'Apariție tematică pentru fotografii și tort.'},
  {title:'Vată de zahăr & popcorn',href:'/vata-de-zahar-popcorn-evenimente/',text:'Food stations pentru evenimente, în configurația confirmată.'}
 ]}/>
 <SeoFooter/>
</main>
</Layout>
