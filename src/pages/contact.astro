---
import Layout from '../layouts/Layout.astro';
import SeoFooter from '../components/SeoFooter.astro';
import { businessFacts } from '../data/business-facts';
---

<Layout 
  title="Contact AnimaParty | Rezervări Animatori Copii"
  description="Contactează echipa AnimaParty pentru a verifica disponibilitatea. Oferim animatori profesioniști pentru petreceri de copii în București și Ilfov. Răspundem rapid pe WhatsApp."
>
  <!-- Hero Section -->
  <section class="relative bg-primary overflow-hidden" style="padding: 100px 0 60px; background: var(--bg-primary);">
    <div class="container mx-auto px-4 relative z-10 text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6" style="font-family: 'Playfair Display', serif; font-size: 3rem; color: white;">Contact și Rezervări</h1>
      <p class="text-xl md:text-2xl text-white/90 max-w-3xl mx-auto" style="font-size: 1.25rem; color: rgba(255, 255, 255, 0.9);">Suntem aici să te ajutăm cu organizarea petrecerii.</p>
    </div>
  </section>

  <!-- Info Section -->
  <section class="py-16 bg-white" style="padding: 60px 0; background: white;">
    <div class="container mx-auto px-4" style="max-width: 1000px;">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 48px;">
        
        <div>
          <h2 class="text-3xl font-bold text-primary mb-6" style="font-family: 'Playfair Display', serif; font-size: 2rem;">Cum poți lua legătura cu noi?</h2>
          <p class="text-secondary mb-6" style="color: var(--text-secondary); line-height: 1.6;">Cea mai rapidă metodă de comunicare este prin WhatsApp. În mesaj, te rugăm să incluzi următoarele detalii pentru a putea verifica rapid disponibilitatea:</p>
          <ul class="space-y-4 text-secondary mb-8" style="color: var(--text-secondary); line-height: 1.6; margin-bottom: 32px;">
            <li style="display: flex; gap: 12px;"><span style="color: var(--accent-gold);">✓</span> Data și ora dorită pentru petrecere</li>
            <li style="display: flex; gap: 12px;"><span style="color: var(--accent-gold);">✓</span> Localitatea și adresa (București sau Ilfov)</li>
            <li style="display: flex; gap: 12px;"><span style="color: var(--accent-gold);">✓</span> Numărul estimat și vârsta copiilor</li>
            <li style="display: flex; gap: 12px;"><span style="color: var(--accent-gold);">✓</span> Personajul sau tipul de animator preferat</li>
          </ul>

          <div style="padding: 24px; background: var(--bg-tertiary); border-radius: 12px; border-left: 4px solid var(--accent-gold);">
            <h3 class="font-bold text-lg mb-4" style="font-size: 1.25rem;">Informații de Contact</h3>
            <p style="margin-bottom: 8px;"><strong>Telefon / WhatsApp:</strong> <a href={`tel:${businessFacts.phone.replace(/\s+/g, '')}`} style="color: var(--accent); font-weight: bold; text-decoration: none;">{businessFacts.phone}</a></p>
            <p style="margin-bottom: 8px;"><strong>Email:</strong> <a href={`mailto:${businessFacts.email}`} style="color: var(--accent); font-weight: bold; text-decoration: none;">{businessFacts.email}</a></p>
            <p><strong>Program:</strong> Răspundem la mesaje în cel mai scurt timp, inclusiv în weekend.</p>
          </div>
        </div>

        <div>
          <h2 class="text-3xl font-bold text-primary mb-6" style="font-family: 'Playfair Display', serif; font-size: 2rem;">Acoperire și Logistică</h2>
          <div class="trust-card mb-6" style="padding: 24px; border-radius: 12px; background: white; border: 1px solid var(--border-subtle);">
            <h3 class="font-bold text-xl mb-3 text-primary" style="font-size: 1.25rem; margin-bottom: 12px;">București</h3>
            <p class="text-secondary" style="color: var(--text-secondary); line-height: 1.5;">{businessFacts.transportBucuresti} Acoperim toate cele 6 sectoare, participând la evenimente organizate la domiciliu, restaurante sau locuri de joacă.</p>
          </div>
          <div class="trust-card" style="padding: 24px; border-radius: 12px; background: white; border: 1px solid var(--border-subtle);">
            <h3 class="font-bold text-xl mb-3 text-primary" style="font-size: 1.25rem; margin-bottom: 12px;">Județul Ilfov</h3>
            <p class="text-secondary" style="color: var(--text-secondary); line-height: 1.5;">{businessFacts.transportIlfov} Organizăm frecvent petreceri în curte sau spații rezidențiale.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="py-16 text-center" style="padding: 60px 0;">
    <a href={`https://wa.me/${businessFacts.phone.replace(/[^0-9]/g, '')}`} class="btn btn-primary btn-whatsapp" style="padding: 16px 32px; border-radius: 8px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; background: #25D366; color: white;" target="_blank" rel="noopener noreferrer">
      Cere Ofertă pe WhatsApp
    </a>
  </section>

  <SeoFooter />
</Layout>
