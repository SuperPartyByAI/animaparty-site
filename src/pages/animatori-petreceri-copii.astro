---
import Layout from '../layouts/Layout.astro';
import Packages from '../components/Packages.astro';
import SeoFooter from '../components/SeoFooter.astro';
import StickyBottomCta from '../components/StickyBottomCta.astro';
import Contact from '../components/Contact.astro';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://animaparty.ro/animatori-petreceri-copii/#webpage",
      "url": "https://animaparty.ro/animatori-petreceri-copii/",
      "name": "Animatori Petreceri Copii | Programe cu Jocuri și Personaje",
      "description": "Animatori pentru petreceri copii cu jocuri interactive, personaje tematice, face painting și baloane modelabile. Vezi pachetele și verifică disponibilitatea pe WhatsApp.",
      "inLanguage": "ro-RO",
      "isPartOf": { "@id": "https://animaparty.ro/#website" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "AnimaParty",
          "item": "https://animaparty.ro/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Animatori Petreceri Copii",
          "item": "https://animaparty.ro/animatori-petreceri-copii/"
        }
      ]
    },
    {
      "@type": "Service",
      "name": "Animatori pentru petreceri copii",
      "provider": {
        "@type": "EntertainmentBusiness",
        "name": "AnimaParty",
        "url": "https://animaparty.ro/"
      },
      "areaServed": ["București", "Ilfov"],
      "description": "Program complet de animație la petreceri pentru copii cu jocuri interactive, face painting, modelaj baloane și momente de spectacol."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Cât durează un program de animație pentru petreceri?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Programul standard poate fi de 1 oră sau 2 ore, în funcție de pachetul ales și de numărul de copii invitați."
          }
        },
        {
          "@type": "Question",
          "name": "Ce se întâmplă dacă sunt mai mult de 15 copii?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pentru grupurile mai mari de 15 copii, recomandăm pachetul cu 2 animatori pentru a asigura o interacțiune echilibrată și desfășurarea rapidă a activităților."
          }
        },
        {
          "@type": "Question",
          "name": "Face painting-ul și baloanele sunt incluse?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Da, toate pachetele noastre includ sesiuni de pictură pe față și modelaj de baloane, fără costuri suplimentare."
          }
        },
        {
          "@type": "Question",
          "name": "Cum aleg personajul potrivit pentru petrecere?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Puteți alege dintr-o varietate de personaje tematice (prințese, supereroi, mascote amuzante) în funcție de preferințele copilului și tematica petrecerii."
          }
        },
        {
          "@type": "Question",
          "name": "Animatorii participă la momentul tortului?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cu siguranță! Animatorul organizează copiii și este alături de sărbătorit în momentul aducerii tortului."
          }
        },
        {
          "@type": "Question",
          "name": "Pentru ce locații oferiți servicii de animație?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ne deplasăm la locația dumneavoastră, fie că este vorba despre acasă, restaurant, grădiniță sau un spațiu de joacă dedicat."
          }
        },
        {
          "@type": "Question",
          "name": "Cum rezerv animatorii?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cel mai simplu este să ne contactați pe WhatsApp cu data evenimentului, ora, locația și numărul estimat de copii."
          }
        }
      ]
    }
  ]
});
---

<Layout 
  title="Animatori Petreceri Copii | Programe cu Jocuri și Personaje"
  description="Animatori pentru petreceri copii cu jocuri interactive, personaje tematice, face painting și baloane modelabile. Vezi pachetele și verifică disponibilitatea pe WhatsApp."
  canonical="https://animaparty.ro/animatori-petreceri-copii/"
  schema={schema}
>
  <main class="page-container">
    <header class="service-hero">
      <div class="container text-center">
        <h1 class="hero-h1">Animatori pentru Petreceri Copii</h1>
        <p class="hero-desc">Pachete complete de animație cu jocuri interactive, concursuri, personaje tematice de poveste, pictură pe față și modelaj de baloane. Creăm o atmosferă plină de bucurie și energie pentru cei mici!</p>
        <div class="hero-actions" style="margin-bottom: 40px;">
          <a href="https://wa.me/40792864811" class="btn btn-primary btn-whatsapp" target="_blank" rel="noopener noreferrer" style="padding: 16px 32px; border-radius: 8px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center;">
            <svg class="w-6 h-6 mr-2 icon-svg" style="width: 24px; height: 24px; display: inline-block; vertical-align: middle; margin-right: 8px;" viewBox="0 0 24 24"><path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
            Verifică disponibilitatea pe WhatsApp
          </a>
        </div>
        <div class="hero-image-wrapper mt-10" style="margin-top: 40px;">
          <img src="/animaparty-jocuri-interactive.webp" alt="Animator coordonând jocuri interactive la petrecere copii" style="width: 100%; max-height: 500px; object-fit: cover; border-radius: 16px; box-shadow: 0 20px 40px rgba(0,0,0,0.15);" />
        </div>
      </div>
    </header>

    <section class="section-padding bg-secondary">
      <div class="container">
        <h2 class="text-3xl md:text-4xl font-extrabold mb-8 text-center text-primary">Ce include programul de animație?</h2>
        <div class="grid md:grid-cols-2 gap-8" style="display: grid; gap: 30px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); margin-top: 40px;">
          <div class="glass-card" style="padding: 30px; background: #fff; border: 1px solid rgba(8, 126, 139, 0.1);">
            <h3 class="text-xl font-bold mb-4" style="color: var(--accent); margin-bottom: 15px; font-size: 1.25rem;">Jocuri și Concursuri Interactive</h3>
            <p style="color: var(--text-secondary); font-size: 1rem; line-height: 1.6;">Activități adaptate vârstei copiilor, care încurajează spiritul de echipă, mișcarea și râsetele. Totul este coordonat de animator într-un mod dinamic și captivant.</p>
          </div>
          <div class="glass-card" style="padding: 30px; background: #fff; border: 1px solid rgba(8, 126, 139, 0.1);">
            <h3 class="text-xl font-bold mb-4" style="color: var(--accent); margin-bottom: 15px; font-size: 1.25rem;">Face Painting și Baloane</h3>
            <p style="color: var(--text-secondary); font-size: 1rem; line-height: 1.6;">Sesiuni creative în care cei mici se transformă în personaje fantastice prin pictură pe față (adaptată preferințelor), plus figurine din baloane modelabile, oferite ca mici suveniruri.</p>
          </div>
          <div class="glass-card" style="padding: 30px; background: #fff; border: 1px solid rgba(8, 126, 139, 0.1);">
            <h3 class="text-xl font-bold mb-4" style="color: var(--accent); margin-bottom: 15px; font-size: 1.25rem;">Atmosferă cu Personaje Tematice</h3>
            <p style="color: var(--text-secondary); font-size: 1rem; line-height: 1.6;">Alegem personajul care să se potrivească tematicii evenimentului: supereroi curajoși, prințese grațioase sau mascote vesele, toate cu o prezență dedicată și prietenoasă.</p>
          </div>
          <div class="glass-card" style="padding: 30px; background: #fff; border: 1px solid rgba(8, 126, 139, 0.1);">
            <h3 class="text-xl font-bold mb-4" style="color: var(--accent); margin-bottom: 15px; font-size: 1.25rem;">Momentul Festiv al Tortului</h3>
            <p style="color: var(--text-secondary); font-size: 1rem; line-height: 1.6;">La finalul programului, coordonăm copiii pentru cântatul de „La mulți ani” și creăm contextul ideal pentru poze memorabile de familie.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section-padding">
      <div class="container text-center" style="max-width: 800px; margin: 0 auto;">
        <h2 class="text-3xl md:text-4xl font-extrabold mb-6 text-primary">Câți animatori să aleg? 1 sau 2?</h2>
        <p class="text-lg mb-6" style="color: var(--text-secondary); font-size: 1.1rem; line-height: 1.6; margin-bottom: 20px;">Alegerea corectă depinde de numărul de invitați. Dacă la petrecere participă până la 15 copii, un singur animator poate gestiona foarte bine toate activitățile, de la jocuri până la baloane și pictură.</p>
        <p class="text-lg" style="color: var(--text-secondary); font-size: 1.1rem; line-height: 1.6;">Dacă grupul depășește 15 copii, prezența a 2 animatori devine esențială. Astfel, atenția se împarte eficient, așteptarea la pictură pe față scade semnificativ, iar jocurile pe echipe devin mult mai spectaculoase.</p>
      </div>
    </section>
    
    <section class="section-padding bg-secondary">
      <div class="container text-center" style="max-width: 800px; margin: 0 auto;">
        <h2 class="text-3xl md:text-4xl font-extrabold mb-6 text-primary">Pentru ce fel de evenimente?</h2>
        <p class="text-lg mb-6" style="color: var(--text-secondary); font-size: 1.1rem; line-height: 1.6;">Programele noastre de animație sunt extrem de flexibile. Ne putem adapta spațiului disponibil, fie că organizați petrecerea acasă, în curte, la un restaurant, la o grădiniță sau într-un loc special amenajat de joacă. Totodată, pe lângă aniversări clasice, animatorii aduc bucurie și la evenimente de botez sau petreceri de tăiere a moțului, menținând copiii ocupați și fericiți.</p>
      </div>
    </section>

    <Packages 
      title="Pachete și Prețuri pentru Animatori Petreceri Copii"
      subtitle="Structuri transparente, adaptate nevoilor tale. Alege varianta potrivită de timp și număr de animatori pentru evenimentul tău."
    />

    <section class="section-padding" id="faq">
      <div class="container" style="max-width: 800px; margin: 0 auto;">
        <h2 class="text-3xl md:text-4xl font-extrabold text-center mb-10 text-primary" style="margin-bottom: 50px;">Întrebări Frecvente (FAQ)</h2>
        <div class="space-y-6 text-left" style="display: flex; flex-direction: column; gap: 24px;">
          <div class="faq-item" style="border-bottom: 1px solid var(--border-subtle); padding-bottom: 20px;">
            <h3 class="text-lg font-semibold mb-2" style="color: var(--text-primary); font-size: 1.15rem; margin-bottom: 10px;">Cât durează un program de animație pentru petreceri?</h3>
            <p style="color: var(--text-secondary); line-height: 1.5;">Programul standard poate fi de 1 oră sau 2 ore, în funcție de pachetul ales și de numărul de copii invitați.</p>
          </div>
          <div class="faq-item" style="border-bottom: 1px solid var(--border-subtle); padding-bottom: 20px;">
            <h3 class="text-lg font-semibold mb-2" style="color: var(--text-primary); font-size: 1.15rem; margin-bottom: 10px;">Ce se întâmplă dacă sunt mai mult de 15 copii?</h3>
            <p style="color: var(--text-secondary); line-height: 1.5;">Pentru grupurile mai mari de 15 copii, recomandăm pachetul cu 2 animatori pentru a asigura o interacțiune echilibrată și desfășurarea rapidă a activităților.</p>
          </div>
          <div class="faq-item" style="border-bottom: 1px solid var(--border-subtle); padding-bottom: 20px;">
            <h3 class="text-lg font-semibold mb-2" style="color: var(--text-primary); font-size: 1.15rem; margin-bottom: 10px;">Face painting-ul și baloanele sunt incluse?</h3>
            <p style="color: var(--text-secondary); line-height: 1.5;">Da, toate pachetele noastre includ sesiuni de pictură pe față și modelaj de baloane, fără costuri suplimentare.</p>
          </div>
          <div class="faq-item" style="border-bottom: 1px solid var(--border-subtle); padding-bottom: 20px;">
            <h3 class="text-lg font-semibold mb-2" style="color: var(--text-primary); font-size: 1.15rem; margin-bottom: 10px;">Cum aleg personajul potrivit pentru petrecere?</h3>
            <p style="color: var(--text-secondary); line-height: 1.5;">Puteți alege dintr-o varietate de personaje tematice (prințese, supereroi, mascote amuzante) în funcție de preferințele copilului și tematica petrecerii.</p>
          </div>
          <div class="faq-item" style="border-bottom: 1px solid var(--border-subtle); padding-bottom: 20px;">
            <h3 class="text-lg font-semibold mb-2" style="color: var(--text-primary); font-size: 1.15rem; margin-bottom: 10px;">Animatorii participă la momentul tortului?</h3>
            <p style="color: var(--text-secondary); line-height: 1.5;">Cu siguranță! Animatorul organizează copiii și este alături de sărbătorit în momentul aducerii tortului.</p>
          </div>
          <div class="faq-item" style="border-bottom: 1px solid var(--border-subtle); padding-bottom: 20px;">
            <h3 class="text-lg font-semibold mb-2" style="color: var(--text-primary); font-size: 1.15rem; margin-bottom: 10px;">Pentru ce locații oferiți servicii de animație?</h3>
            <p style="color: var(--text-secondary); line-height: 1.5;">Ne deplasăm la locația dumneavoastră, fie că este vorba despre acasă, restaurant, grădiniță sau un spațiu de joacă dedicat.</p>
          </div>
          <div class="faq-item" style="border-bottom: 1px solid var(--border-subtle); padding-bottom: 20px;">
            <h3 class="text-lg font-semibold mb-2" style="color: var(--text-primary); font-size: 1.15rem; margin-bottom: 10px;">Cum rezerv animatorii?</h3>
            <p style="color: var(--text-secondary); line-height: 1.5;">Cel mai simplu este să ne contactați pe WhatsApp cu data evenimentului, ora, locația și numărul estimat de copii.</p>
          </div>
        </div>
      </div>
    </section>
    
    <Contact />
    <SeoFooter />
    <StickyBottomCta />
  </main>
</Layout>

<style>
  .service-hero {
    background: linear-gradient(135deg, var(--bg-tertiary) 0%, var(--bg-primary) 100%);
    padding: 160px 0 80px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .hero-h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 24px;
    line-height: 1.1;
  }
  .hero-desc {
    font-size: 1.25rem;
    color: var(--text-secondary);
    max-width: 800px;
    margin: 0 auto 40px;
    line-height: 1.6;
  }
  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
  }
  .section-padding {
    padding: 80px 0;
  }
  .bg-secondary {
    background-color: var(--bg-secondary);
  }
  .text-primary { color: var(--text-primary); }
  .text-accent { color: var(--accent); }
</style>
